# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# aistudio.google.com/apikey -- free tier, no card required
GEMINI_API_KEY=

# Only needed if/when you experiment with a paid provider (Weeks 9-10 experiment)
OPENAI_API_KEY=

# Local docker-compose Postgres (matches docker-compose.yml). Switch to a Supabase/Neon
# connection string later for the hosted deploy -- everything else stays the same.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sf_policy_rag

# Flash Lite models only -- the non-Lite Flash models are capped at 20 req/day
# on the free tier and will throw 429s during eval runs.
LLM_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
